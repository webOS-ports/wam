# Outcome of each test on the x86-64 host with the recipe's flags.
# Tests that reach the web engine's webos::Runtime or webos::WebOSPlatform
# (launching an app, setting the system language) abort here: those
# singletons register with a base::AtExitManager, which the test binary has
# no way to create since libcbe does not export it. Only these are allowed
# to fail. Regenerate with run-sanitizers.sh -u.
CRASH(134) CloseAllApps.CloseAllApps
CRASH(134) ErrorPageTestSuite.LoadErrorPage
CRASH(134) ErrorPageTestSuite.ReloadOnNetworkRecovery
CRASH(134) ErrorPageTestSuite.ReloadOnRelaunch
CRASH(134) ErrorPageTestSuite.ReloadOnTimeout
CRASH(134) GetWebProcessSizeTest.checkCaseProcessExists
CRASH(134) KillAppTest.ForceKillApp
CRASH(134) KillAppTest.KillApp
CRASH(134) LaunchAppTestSuite.LaunchAppsWithError
CRASH(134) LaunchAppTestSuite.LaunchAppsWithoutParams
CRASH(134) LaunchAppTestSuite.LaunchAppsWithParams
CRASH(134) LaunchAppTestSuite.LaunchOnPrimaryDisplay
CRASH(134) LaunchAppTestSuite.LaunchOnSecondaryDisplay
CRASH(134) ListRunningAppsTest.ExcludeSysApps
CRASH(134) ListRunningAppsTest.IncludeSysApps
CRASH(134) PalmSystemBlinkTestSuite.handleBrowserControlMessage_getIdentifier
CRASH(134) PalmSystemBlinkTestSuite.handleBrowserControlMessage_initialize
CRASH(134) PalmSystemBlinkTestSuite.handleBrowserControlMessage_isActivated
CRASH(134) PalmSystemBlinkTestSuite.handleBrowserControlMessage_isKeyboardVisible
CRASH(134) PalmSystemBlinkTestSuite.handleBrowserControlMessage_platformBack
CRASH(134) PalmSystemBlinkTestSuite.handleBrowserControlMessage_PmLogInfoWithClock
CRASH(134) PalmSystemBlinkTestSuite.handleBrowserControlMessage_PmLogString
CRASH(134) PalmSystemBlinkTestSuite.handleBrowserControlMessage_setCursor
CRASH(134) PalmSystemBlinkTestSuite.handleBrowserControlMessage_setKeyMask_Back
CRASH(134) PalmSystemBlinkTestSuite.handleBrowserControlMessage_setKeyMask_Combination
CRASH(134) PalmSystemBlinkTestSuite.handleBrowserControlMessage_setKeyMask_Exit
CRASH(134) PalmSystemBlinkTestSuite.handleBrowserControlMessage_setKeyMask_Home
CRASH(134) PalmSystemBlinkTestSuite.handleBrowserControlMessage_setKeyMask_Incorrect
CRASH(134) PalmSystemBlinkTestSuite.handleBrowserControlMessage_setWindowProperty
CRASH(134) PauseAppTest.PauseApp
CRASH(134) SetInspectorEnableTest.checkCaseApplicationExists
CRASH(134) SetInspectorEnableTest.checkCaseApplicationNotExists
